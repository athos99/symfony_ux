{% extends 'base.html.twig' %}

{% block title %}Test Stimulus{% endblock %}

{% block body %}
    <h1>salut le monde</h1>
    <div data-controller="hello"></div>

    <div
        data-controller="stimulus"
        data-stimulus-text-value="bonjour tout le monde !"
        data-stimulus-delay-value="150"
    >
        <label>
            Pause entre les lettres :
            <input
                type="range"
                min="50"
                max="1000"
                step="50"
                value="150"
                data-stimulus-target="delayInput"
                data-action="input->stimulus#updateDelay"
            >
        </label>
        <span data-stimulus-target="output" aria-live="polite"></span>
    </div>
{% endblock %}